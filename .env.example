# Copy to .env and fill in. .env should be gitignored.
# For Vercel deployment, set these as Project Environment Variables instead.

# ============================================================
# Email delivery — pick ONE of (Resend) or (SMTP).
# Resend is recommended for Vercel; SMTP is the local fallback.
# ============================================================

# --- Resend (preferred for Vercel) ---
# Sign up at https://resend.com, verify a domain (or use onboarding@resend.dev for testing).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
ALERT_FROM=alerts@yourdomain.com
ALERT_TO=you@gmail.com

# --- SMTP fallback (local dev with Gmail) ---
# Gmail with an app password is the easiest:
#   1. Enable 2FA on your Google account
#   2. https://myaccount.google.com/apppasswords -> create an app password
#   3. Use the from-email as SMTP_USER, the app password as SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password-here

# ============================================================
# Vercel KV (storage for rules + dedup + history)
# Created automatically when you provision a KV store in the Vercel dashboard.
# Without these the code falls back to state/kv.json on local disk.
# ============================================================
KV_REST_API_URL=https://your-store.kv.vercel-storage.com
KV_REST_API_TOKEN=AYxx...

# ============================================================
# Cron security
# Generate any random secret, set the same value here AND in the Vercel
# project's CRON_SECRET env var. Vercel Cron sends `Authorization: Bearer <secret>`.
# ============================================================
CRON_SECRET=

# ============================================================
# Alpaca Markets — live quote polling (free IEX tier).
# Paper or live keys both work for data access. Get them from
# https://app.alpaca.markets -> API Keys (regenerate to see secret).
# Either naming convention is accepted:
#   APCA_API_KEY_ID / APCA_API_SECRET_KEY  (official SDK)
#   ALPACA_API_KEY  / ALPACA_SECRET_KEY    (this project's preference)
# ============================================================
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
