{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": ".",
  "crons": [
    {
      "path": "/api/scan",
      "schedule": "30 21 * * 1-5"
    }
  ],
  "functions": {
    "api/scan.py": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/rules.py": {
      "maxDuration": 10
    },
    "api/history.py": {
      "maxDuration": 10
    },
    "api/alerts.py": {
      "maxDuration": 10
    },
    "api/alerts/scan.py": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/watchlist.py": {
      "maxDuration": 10
    },
    "api/chart/[ticker].py": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/summary/[ticker].py": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/backtest/[ticker].py": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/sweep/[ticker].py": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/drawings/[ticker].py": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/style.css", "destination": "/frontend/style.css" },
    { "source": "/chart.js", "destination": "/frontend/chart.js" },
    { "source": "/backtest.html", "destination": "/frontend/backtest.html" },
    { "source": "/backtest.js", "destination": "/frontend/backtest.js" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
