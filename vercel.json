{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/scan",
      "schedule": "30 21 * * 1-5"
    }
  ],
  "functions": {
    "app.py": { "maxDuration": 60, "memory": 1024 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
